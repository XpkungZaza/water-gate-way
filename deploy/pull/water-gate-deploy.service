# Oneshot run of pull-deploy.sh. Installed as /etc/systemd/system/water-gate-deploy.service (needs sudo once).
[Unit]
Description=Water Gate Way pull deployer
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=cmmc
Environment=HOME=/home/cmmc
ExecStart=/home/cmmc/wgw/deploy/pull-deploy.sh
