# Oneshot run of pull-deploy.sh. Installed as a user-owned unit under /etc/systemd/system (needs sudo once).
[Unit]
Description=Water Gate Way pull deployer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cmmc
Environment=HOME=/home/cmmc
ExecStart=/home/cmmc/wgw/deploy/pull-deploy.sh
